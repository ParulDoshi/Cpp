#include <iostream>
using namespace std;
int main()
{
    int n;
    cin>>n;
    for(int row=1;row<=n;row=row+1){
        for (int col=1;col<=n-row;col=col+1){
            cout<<" ";
        }
        for(int col=row;col>=1;col--){
            cout<<col;
        }
        cout<<endl;
    }

    return 0;
}
