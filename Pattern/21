      A
     AB
    ABC
   ABCD
  ABCDE 

#include <iostream>
using namespace std;
int main()
{
    int n;
    cin>>n;
    for(int row=1;row<=n;row=row+1){
        for (int col=1;col<=n-row;col=col+1){
            cout<<" ";
        }
        for(char name ='A';name<='A'+row-1;name=name+1){
            cout<<name;
        }
        cout<<endl;
    }

    return 0;
}
